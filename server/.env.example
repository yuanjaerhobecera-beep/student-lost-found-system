# =============================================================
# Copy this file's settings into server/.env and fill in YOUR values.
# This example file is uploaded to GitHub, so never put real secrets here.
# =============================================================

# ---------- Server ----------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ---------- Database (REQUIRED) ----------
MONGO_URI=your_mongodb_atlas_connection_string
DB_NAME=student_lost_found
# Fixes "querySrv ECONNREFUSED" on some networks. Delete the line if you don't need it.
DNS_SERVERS=8.8.8.8,1.1.1.1

# ---------- Login security (REQUIRED) ----------
# A long random secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=paste_a_long_random_secret_here
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# ---------- First admin account (used once by: npm run seed) ----------
ADMIN_EMAIL=admin@your-school-domain
ADMIN_PASSWORD=ChangeThisPassword123

# ---------- School email rule (optional) ----------
# Only allow these email domains to register. Leave empty to allow any email.
# Example: ALLOWED_EMAIL_DOMAINS=yourschool.edu.ph
ALLOWED_EMAIL_DOMAINS=

# ---------- Email / Nodemailer (optional) ----------
# Leave empty during development: emails will be printed in the terminal instead.
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, and use an App Password (not your normal password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Student Lost and Found <your_email_here>

# ---------- Cloudinary image storage (optional) ----------
# Leave empty to save images in server/uploads during development.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAX_UPLOAD_MB=5

# ---------- Production only ----------
# Set to 1 when hosted behind a proxy (Render, Railway, Nginx) so rate limits see the real visitor IP.
# TRUST_PROXY=1
